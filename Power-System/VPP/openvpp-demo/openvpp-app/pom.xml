<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.openvpp</groupId>
        <artifactId>openvpp-demo</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>openvpp-app</artifactId>
    <name>openvpp-app</name>
    <description>启动模块：单体可跑，专栏演示用聚合启动；生产形态按业务域拆分部署</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>com.openvpp</groupId>
            <artifactId>openvpp-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.openvpp</groupId>
            <artifactId>openvpp-iot</artifactId>
        </dependency>
        <dependency>
            <groupId>com.openvpp</groupId>
            <artifactId>openvpp-resource</artifactId>
        </dependency>
        <dependency>
            <groupId>com.openvpp</groupId>
            <artifactId>openvpp-assessment</artifactId>
        </dependency>
        <dependency>
            <groupId>com.openvpp</groupId>
            <artifactId>openvpp-aggregator</artifactId>
        </dependency>
        <dependency>
            <groupId>com.openvpp</groupId>
            <artifactId>openvpp-dispatch</artifactId>
        </dependency>
        <dependency>
            <groupId>com.openvpp</groupId>
            <artifactId>openvpp-settlement</artifactId>
        </dependency>
        <dependency>
            <groupId>com.openvpp</groupId>
            <artifactId>openvpp-market</artifactId>
        </dependency>
        <dependency>
            <groupId>com.openvpp</groupId>
            <artifactId>openvpp-edge</artifactId>
        </dependency>
        <dependency>
            <groupId>com.openvpp</groupId>
            <artifactId>openvpp-gateway</artifactId>
        </dependency>

        <!-- 教学持久化：H2 内嵌数据库（文件模式），读者零外部依赖即可跑通；
             生产形态在 application.yml 切换为 MySQL/PostgreSQL，见第 25 篇 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <!-- 非 spring-boot-starter-parent 继承时须显式绑定 repackage，产出可执行 fat jar -->
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
