{
  "modelId": "storage-pcs-v1",
  "name": "储能变流器（PCS）物模型 v1",
  "properties": [
    { "identifier": "soc",    "name": "荷电状态",   "dataType": "DOUBLE", "unit": "%",  "min": 0,    "max": 100,  "writable": false },
    { "identifier": "power",  "name": "当前功率",   "dataType": "DOUBLE", "unit": "kW", "min": -2000, "max": 2000, "writable": false },
    { "identifier": "temp",   "name": "电池温度",   "dataType": "DOUBLE", "unit": "°C", "min": -20,  "max": 60,   "writable": false },
    { "identifier": "targetPower", "name": "目标功率设定", "dataType": "DOUBLE", "unit": "kW", "min": -2000, "max": 2000, "writable": true }
  ],
  "events": [
    { "identifier": "socLow",  "name": "SOC 低告警" },
    { "identifier": "fault",   "name": "故障" }
  ],
  "services": [
    { "identifier": "setPower", "name": "设定功率", "outputProperty": "targetPower" }
  ]
}
